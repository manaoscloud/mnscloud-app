{
  "name": "mnscloud-app",
  "version": "0.1.933",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --port 4200 --poll 2000",
    "build": "node --max-old-space-size=6144 node_modules/@angular/cli/bin/ng.js build",
    "verify:changed": "node scripts/verify-changed-app.mjs",
    "check:angular-baseline": "node scripts/check-angular-baseline.mjs",
    "check:angular-baseline:strict": "node scripts/check-angular-baseline.mjs --strict",
    "check:crud": "node scripts/validate-crud-template.mjs",
    "check:crud:i18n": "node scripts/validate-crud-i18n.mjs",
    "check:crud:layout": "node scripts/validate-crud-layout.mjs",
    "check:crud:fk": "node scripts/validate-crud-fk-quick-create.mjs",
    "check:crud:inventory": "node scripts/validate-crud-inventory.mjs",
    "check:field-help": "node scripts/validate-field-help.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build-watch": "ng build --configuration production --watch",
    "check:nav": "node scripts/validate-nav-labels.mjs",
    "check:dialog-report": "node scripts/validate-dialog-report-button.mjs",
    "check:dashboard": "node scripts/validate-dashboard-template.mjs",
    "test:dashboard": "ng test --watch=false --include='src/app/shared/dashboard/*.spec.ts' --include='src/app/pages/cyber-security/secrets/dashboard/*.spec.ts' --karma-config=karma.dashboard.cjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.0.1",
    "@angular/common": "^22.0.1",
    "@angular/compiler": "^22.0.1",
    "@angular/core": "^22.0.1",
    "@angular/forms": "^22.0.1",
    "@angular/material": "^22.0.1",
    "@angular/platform-browser": "^22.0.1",
    "@angular/router": "^22.0.1",
    "@jsverse/transloco": "^8.4.0",
    "@mapbox/mapbox-gl-draw": "^1.5.1",
    "@mapbox/mapbox-gl-geocoder": "^5.1.2",
    "html2canvas-pro": "^2.5.0",
    "mapbox-gl": "^3.24.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.1",
    "@angular/cli": "^22.0.1",
    "@angular/compiler-cli": "^22.0.1",
    "@types/jasmine": "^6.0.0",
    "@types/mapbox__mapbox-gl-draw": "^1.4.4",
    "@types/mapbox__mapbox-gl-geocoder": "^5.1.0",
    "concurrently": "^10.0.3",
    "http-server": "^14.1.1",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "^6.3.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
    "typescript": "~6.0.3"
  }
}
